# 로컬 개발 — 백엔드(Spring Boot, 포트 7070 고정) 주소.
# docker compose 로 풀스택을 띄울 때도 브라우저는 localhost:7070 으로 접근하므로 동일하게 둔다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7070

# Next.js Route Handler(BFF, 서버 런타임)가 백엔드를 호출할 때 쓰는 주소 — 브라우저가 아니라
# Node 서버 프로세스에서 나가는 요청이므로 로컬 단독 실행 시엔 localhost:7070, docker-compose
# 내부에서는 컨테이너 서비스명(sodam-be:7070)으로 override 된다(docker-compose.yml 참고).
BACKEND_INTERNAL_URL=http://localhost:7070
